# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/refchain?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# M-Pesa Daraja API
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_lipa_na_mpesa_passkey
MPESA_CALLBACK_URL=https://your-backend-url.com/api/payments/callback
MPESA_ENV=sandbox

# Admin
ADMIN_EMAIL=admin@refchain.com
ADMIN_PASSWORD=Admin@123456

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Production safety switch (spec section 47).
# These are read directly from env, never from the database, so a DB write can never
# silently turn on real-money payments/withdrawals. Both must be explicitly flipped
# before any real M-Pesa charge or payout can happen.
PAYMENTS_MODE=demo
WITHDRAWALS_ENABLED=false

# Reward & withdrawal config — SEED DEFAULTS ONLY.
# These values are read once by `node src/utils/seedSettings.js` to create the
# SystemSettings row. After that, change them from the admin dashboard, not here —
# editing this file will not affect an already-seeded database.
ENTRY_AMOUNT=200
LEVEL_1_REWARD=100
LEVEL_2_REWARD=50
LEVEL_3_REWARD=0
MAX_REWARD_LEVEL=2
MIN_WITHDRAWAL=100
MAX_DAILY_WITHDRAWAL=5000
MAX_WITHDRAWALS_PER_DAY=3
MIN_WITHDRAWAL_BALANCE=1500
MIN_QUALIFIED_REFERRALS=3
